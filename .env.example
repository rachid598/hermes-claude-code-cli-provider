# Placeholder key accepted by the local shim. It is ignored, but Hermes expects
# an API-key-shaped provider profile to have a non-empty key.
CLAUDE_CODE_CLI_API_KEY=local

# Keep this in sync with CLAUDE_CODE_CLI_HOST / CLAUDE_CODE_CLI_PORT if you
# change the shim's bind address.
CLAUDE_CODE_CLI_BASE_URL=http://127.0.0.1:8765/v1

# Set to 0/false/no/off to disable provider-import autostart and run start.sh
# manually or via scripts/install-service.sh instead.
CLAUDE_CODE_CLI_AUTOSTART=1

# Optional shim controls:
# CLAUDE_CODE_CLI_HOST=127.0.0.1
# CLAUDE_CODE_CLI_PORT=8765
# CLAUDE_CODE_CLI_BIN=/path/to/claude
# CLAUDE_CODE_CLI_ENGINE=auto
# CLAUDE_CODE_CLI_CWD=/path/to/project
# CLAUDE_CODE_CLI_STREAM=1
# CLAUDE_CODE_CLI_VISION=1
# CLAUDE_CODE_CLI_MAX_IMAGES=8
# CLAUDE_CODE_CLI_MAX_IMAGE_MB=20
# CLAUDE_CODE_CLI_TIMEOUT=600
